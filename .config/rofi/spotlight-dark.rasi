/*******************************************************************************
 * MACOS SPOTLIGHT LIKE DARK THEME FOR ROFI 
 * User                 : LR-Tech               
 * Theme Repo           : https://github.com/lr-tech/rofi-themes-collection
 *******************************************************************************/

@import "colors.rasi"

* {
    background-color:   transparent;
    text-color:         @fg;

    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    background-color:   @bg;

    location:       center;
    width:          500;
    border-radius:  8;
}

inputbar {
    padding:    12px 24px;
    spacing:    12px;
    children:   [ entry ];
}

icon-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
    font:   inherit;

    placeholder         : "Search";
    placeholder-color   : @bg-border;
}

message {
    border:             2px 0 0;
    border-color:       @bg-border;
    background-color:   @bg-border;
}

textbox {
    padding:    8px 24px;
}

listview {
    lines:      10;
    columns:    1;

    fixed-height:   true;
    border:         1px 0 0;
    border-color:   @bg-border;
}

element {
    padding:            8px 16px;
    spacing:            16px;
    background-color:   transparent;
}

element normal active {
    text-color: @bg-selected;
}

element selected normal, element selected active {
    background-color:   @bg-selected;
    text-color:         @fg-selected;
}

element-icon {
    size:   1em;
}

element-text {
    text-color: inherit;
}

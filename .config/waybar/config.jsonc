// waybar(5)
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,
    "exclusive": true,
    "gtk-layer-shell": false,
    "passthrough": false,
    "fixed-center": true,
    "modules-left": ["tray", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/todoist", "hyprland/language" , "network", "power-profiles-daemon", "battery", "pulseaudio", "backlight", "custom/power"],

    "tray": {
        "show-passive-items": true,
        "spacing": 10
    },

    // waybar-hyprland-workspaces(5)
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "warp-on-scroll": false,
        "show-special": false,
        "active-only": false,
        "move-to-monitor": false,
        "sort-by": [],
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": ""
        }
    },

    "hyprland/language": {
        "format": "   {shortDescription}-{short} {variant}"
    },

    "battery": {
       "adapter": "ADP0",
       "interval": 1,
       "states": {
           "warning": 30,
           "critical": 15
       },
       "max-length": 20,
       "format": "{icon}{capacity}% ({power:4.2f}W)",
       "format-warning": "<span foreground='#ffff26'>  {capacity}%</span>",
       "format-critical": "<span foreground='#ff2655'>  {capacity}%</span>",
       "format-charging": "<span foreground='#26ff55'>  {capacity}%</span>",
       "format-plugged": "<span foreground='#26ff55'>  {capacity}%</span>",
       "format-alt": "{icon} {time}",
       "format-full": "<span foreground='#26ff55'> {capacity}%</span>",
       "format-icons": ["   ", "   ", "   ", "   ", "   "]
    },

    "clock": {
        "interval": 1,
        "format": "<span color='#ffffff'>   </span>{:%a %b %d %H:%M:%S}",
        "format-alt": "<span color='#ffffff'> </span>{:%a %b %d}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "  {usage}%",
        "tooltip": true,
        "interval": 1
    },

    "memory": {
        "format": "  {used:0.2f}G"
    },

    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "  {essid} ({signalStrength}%)",
        //"format-ethernet": "󰈁{ipaddr}/{cidr}  ",
        "format-ethernet": "󰈁 {ifname}",
        "tooltip-format": "{ifname} via {gwaddr}  ",
        "format-linked": "NET {ifname} (No IP)  ",
        "format-disconnected": "Disconnected",
        "format-alt": "NET {ifname}: {ipaddr}/{cidr}"
    },

    // waybar-pulseaudio(5)
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  muted",
        "format-icons": {
            "headphone": " ",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [" ", " ", " "]
            },
        "on-click": "pamixer --toggle-mute",
        "scroll-step": 2
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{icon}  {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "power-profiles-daemon": {
         "format": "{icon}   {profile}",
         "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
         "tooltip": true,
         "format-icons": {
             "default": "",
             "performance": "",
             "balanced": "",
             "power-saver": ""
        }
    },
    "custom/sep": {
        "format": "|",
        "tooltip": false
    },
    "custom/power": {
        "tooltip": false,
        "on-click": "wlogout -p layer-shell &",
        "format": " "
    },
     "custom/todoist": {
         "interval": 60,
         "exec": "python3 -u ~/Code/Python/todoist-bar-module/todoist-bar-module.py",
         "format": "  {}",
         "on-click": "xdg-open https://www.todoist.com"
    }
}
